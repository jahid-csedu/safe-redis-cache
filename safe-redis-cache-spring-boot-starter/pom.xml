<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.jahidcsedu</groupId>
    <artifactId>safe-redis-cache-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <!--
    A starter has no code. It is just a curated list of dependencies.
    Users add this one artifact and get: our auto-configuration + Spring Cache + Redisson.
    Naming rule: third-party starters are "xxx-spring-boot-starter";
    "spring-boot-starter-xxx" is reserved for the Spring team.
  -->
  <artifactId>safe-redis-cache-spring-boot-starter</artifactId>
  <name>Safe Redis Cache starter</name>

  <dependencies>
    <dependency>
      <groupId>io.github.jahidcsedu</groupId>
      <artifactId>safe-redis-cache-spring-boot-autoconfigure</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-cache</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-redis</artifactId>
    </dependency>
    <!-- Redisson also provides the RedisConnectionFactory, so RedisTemplate and our cache share one client -->
    <dependency>
      <groupId>org.redisson</groupId>
      <artifactId>redisson-spring-boot-starter</artifactId>
    </dependency>
  </dependencies>
</project>
