<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Note: a library does NOT use spring-boot-starter-parent as its parent.
    We import the Spring Boot BOM instead, so we get managed versions without
    forcing our parent/plugins on the apps that depend on us.
  -->
  <groupId>io.github.jahidcsedu</groupId>
  <artifactId>safe-redis-cache-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Safe Redis Cache (parent)</name>
  <description>Spring Boot starter that protects a Redis cache from avalanche, stampede and penetration.</description>

  <modules>
    <module>safe-redis-cache-spring-boot-autoconfigure</module>
    <module>safe-redis-cache-spring-boot-starter</module>
    <module>safe-redis-cache-sample</module>
  </modules>

  <properties>
    <!--
      The minimum Java version for anyone USING the library: classes are compiled to Java 17 bytecode.
      You can still build with a newer JDK (e.g. 25); "release" makes javac reject APIs newer than 17.
      Spring Boot 3.x itself requires 17, so going lower would gain nothing.
    -->
    <java.version>17</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <spring-boot.version>3.5.16</spring-boot.version>
    <redisson.version>4.8.0</redisson.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Our own modules -->
      <dependency>
        <groupId>io.github.jahidcsedu</groupId>
        <artifactId>safe-redis-cache-spring-boot-autoconfigure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.jahidcsedu</groupId>
        <artifactId>safe-redis-cache-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!--
        Redisson 4.x's starter defaults to the Spring Data module for Boot 4 (redisson-spring-data-41).
        We target Boot 3.5, so we swap it for redisson-spring-data-35.
      -->
      <dependency>
        <groupId>org.redisson</groupId>
        <artifactId>redisson-spring-boot-starter</artifactId>
        <version>${redisson.version}</version>
        <exclusions>
          <exclusion>
            <groupId>org.redisson</groupId>
            <artifactId>redisson-spring-data-41</artifactId>
          </exclusion>
        </exclusions>
      </dependency>
      <dependency>
        <groupId>org.redisson</groupId>
        <artifactId>redisson-spring-data-35</artifactId>
        <version>${redisson.version}</version>
      </dependency>
      <dependency>
        <groupId>org.redisson</groupId>
        <artifactId>redisson</artifactId>
        <version>${redisson.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <!-- keep method parameter names, Spring uses them for SpEL keys like #id -->
            <parameters>true</parameters>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
