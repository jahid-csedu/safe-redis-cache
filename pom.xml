<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Note: a library does NOT use spring-boot-starter-parent as its parent.
    We import the Spring Boot BOM instead, so we get managed versions without
    forcing our parent/plugins on the apps that depend on us.
  -->
  <groupId>io.github.jahidcsedu</groupId>
  <artifactId>safe-redis-cache-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>
  <name>Safe Redis Cache (parent)</name>
  <description>Spring Boot starter that protects a Redis cache from avalanche, stampede and penetration.</description>

  <!-- Inherited by every module; Maven Central requires license info in each published pom -->
  <licenses>
    <license>
      <name>Apache License, Version 2.0</name>
      <url>https://www.apache.org/licenses/LICENSE-2.0</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <modules>
    <module>safe-redis-cache-spring-boot-autoconfigure</module>
    <module>safe-redis-cache-spring-boot-starter</module>
    <module>safe-redis-cache-sample</module>
  </modules>

  <properties>
    <!--
      The minimum Java version for anyone USING the library: classes are compiled to Java 17 bytecode.
      You can still build with a newer JDK (e.g. 25); "release" makes javac reject APIs newer than 17.
      Spring Boot 4.x itself requires 17, so going lower would gain nothing.
    -->
    <java.version>17</java.version>
    <maven.compiler.release>${java.version}</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!--
      A library builds against the OLDEST Boot line it supports (here 4.1), so 4.1 apps can use it.
      Users on newer 4.x get their own newer versions through their own Boot BOM.
    -->
    <spring-boot.version>4.1.3</spring-boot.version>
    <redisson.version>4.8.0</redisson.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-dependencies</artifactId>
        <version>${spring-boot.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>

      <!-- Our own modules -->
      <dependency>
        <groupId>io.github.jahidcsedu</groupId>
        <artifactId>safe-redis-cache-spring-boot-autoconfigure</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.github.jahidcsedu</groupId>
        <artifactId>safe-redis-cache-spring-boot-starter</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!--
        Redisson's starter pulls in redisson-spring-data-41, the bridge for Spring Data Redis 4.1 (= Boot 4.1).
        When we later test on Boot 4.2, that bridge must be swapped for redisson-spring-data-42.
      -->
      <dependency>
        <groupId>org.redisson</groupId>
        <artifactId>redisson-spring-boot-starter</artifactId>
        <version>${redisson.version}</version>
      </dependency>
      <dependency>
        <groupId>org.redisson</groupId>
        <artifactId>redisson</artifactId>
        <version>${redisson.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <pluginManagement>
      <plugins>
        <plugin>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-maven-plugin</artifactId>
          <version>${spring-boot.version}</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-compiler-plugin</artifactId>
          <configuration>
            <!-- keep method parameter names, Spring uses them for SpEL keys like #id -->
            <parameters>true</parameters>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>
</project>
